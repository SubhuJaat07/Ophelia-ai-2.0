# ==========================================
# 🤖 OPHELIA AI 3.1 - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values!

# ------------------------------------------
# 🔑 REQUIRED - Discord Bot
# ------------------------------------------
DISCORD_TOKEN=your-discord-bot-token-here
OWNER_IDS=1169492860278669312,1463113729959919801

# ------------------------------------------
# 🧠 AI PROVIDERS (At least one required!)
# ------------------------------------------

# Option 1: Groq (Fast, Free Tier Available)
GROQ_API_KEYS=gsk-your-groq-api-key-1,gsk-your-groq-api-key-2

# Option 2: Google Gemini (Primary Recommended - Generous Free Tier!)
GEMINI_API_KEY=your-gemini-api-key-here

# Option 3: NVIDIA NIM (For Heavy Models)
NVIDIA_API_KEY=your-nvidia-api-key-here

# Option 4: Cerebras (Backup)
CEREBRAS_API_KEY=your-cerebras-api-key-here

# Option 5: OpenRouter (Last Resort)
OPENROUTER_API_KEY=your-openrouter-api-key-here

# ------------------------------------------
# 🌐 EXTERNAL TOOLS (Optional but Recommended!)
# ------------------------------------------

# Web Search (Get free key at https://tavily.com - 1000 searches/month FREE!)
TAVILY_API_KEY=your-tavily-api-key

# Alternative: Brave Search (https://brave.com/search/api/)
BRAVE_API_KEY=your-brave-api-key

# Code Execution (E2B Sandbox - https://e2b.dev)
E2B_API_KEY=your-e2b-api-key

# Note: Pollinations.ai (Image Gen) is 100% FREE - No API Key Needed! ✅

# ------------------------------------------
# 💾 DATABASE (Optional)
# ------------------------------------------
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-anon-key

# ------------------------------------------
# ⚙️ BOT SETTINGS
# ------------------------------------------
DEFAULT_MODEL=llama-3.3-70b-versatile
LOG_LEVEL=INFO
MAX_CONVERSATION_HISTORY=50
CACHE_TTL=3600
DEFAULT_TEMPERATURE=1.02
DEFAULT_MAX_TOKENS=1024

# ------------------------------------------
# 📊 MONITORING (Optional)
# ------------------------------------------
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
